#!/usr/bin/env bash
# xlsx/csv grade matrix + human-review list for one exam: cli_compile data/cli/<exam>/exam_config.json
set -euo pipefail
D="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="${PYTHON:-$D/.venv/bin/python}"; [ -x "$PY" ] || PY=python3
exec "$PY" "$D/src/scoring/compile_ai_grades.py" "$@"
